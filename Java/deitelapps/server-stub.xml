<?xml version="1.0" encoding="UTF-8"?>
<Server port="8005" shutdown="SHUTDOWN">
	<!-- "Service": collezione di uno o piu' "Connector" e una e una sola "Engine"
   -->
	<Service name="Catalina">
		<!-- A "Connector" represents an endpoint by which requests are received
         and responses are returned, for a given protocol: HTTP, AJP, ...
    -->
		<Connector port="8080" protocol="HTTP/1.1" connectionTimeout="20000" redirectPort="8443" />
		<Connector port="8009" protocol="AJP/1.3" redirectPort="8443" />
		<!-- An Engine represents the entry point that processes every request.
         The Engine implementation for Tomcat stand alone analyzes the HTTP headers
         included with the request, and passes them on to the appropriate Host (virtual host). -->
		<Engine name="Catalina" defaultHost="localhost">
			<Host name="localhost" appBase="webapps" autoDeploy="true" unpackWARs="true" />
			<!-- ora un host virtuale deitel.dmi con appBase  "deiteldmiapps" -->
			<Host name="deitel.dmi" appBase="deiteldmiapps" autoDeploy="true" />
			<!-- serve che l'host "deitel.dmi" sopra sia definito in /etc/hosts, da cui http://deitel.dmi:8080
           o nel DNS, vedi http://www.soft-land.org/articoli/tomvhosts -->
		</Engine>
	</Service>
	<!-- definiamo dentro <Server> un <Service> con HTTP su port 8081 con sua appBase "deitelapps"
       questo <Service> e` accessibile via http://localhost:8081;
       ok condividere appBase con altri Service;
       non ok se un'app in questa appBase e 
   -->
	<Service name="Deitel">
		<Connector port="8081" protocol="HTTP/1.1" redirectPort="8443" connectionTimeout="20000" />
		<Engine name="Deitel" defaultHost="localhost">
			<Host name="localhost" appBase="deitelapps" autoDeploy="true" unpackWARs="false" />
			<Host name="deitel1.dmi" appBase="deitelapps" autoDeploy="true" unpackWARs="false" />
		</Engine>
	</Service>

	<Service name="Deitel2">
		<Connector port="8082" protocol="HTTP/1.1" redirectPort="8443" connectionTimeout="20000" />
		<Engine name="Deitel2" defaultHost="deitel2.dmi">
			<Host name="deitel2.dmi" appBase="deiteldmiapps" autoDeploy="true" unpackWARs="false" />
		</Engine>
	</Service>

</Service>

</Server>